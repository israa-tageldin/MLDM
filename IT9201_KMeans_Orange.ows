<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="IT9201 K-Means Clustering — Diabetes Risk Profiling" description="Unsupervised K-Means clustering to discover hidden health-risk profiles in the BRFSS 2015 Diabetes dataset. Pipeline: CSV Load → Select Columns → Preprocess → k-Means → Silhouette → Box Plot → Scatter Plot → Data Table">
